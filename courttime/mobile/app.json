{
  "expo": {
    "name": "CourtTime",
    "slug": "courttime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "courttime",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.courttime.player",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a5f2a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.courttime.player"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CourtTime needs access to your photos so you can choose a profile picture, or a club logo or product photo if you manage a club.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a5f2a"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CourtTime can add your confirmed bookings to your calendar when you choose Add to Calendar.",
          "remindersPermission": "CourtTime can add booking reminders to your calendar when you choose Add to Calendar."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "7ca94b1b-5354-470a-9275-e6ab67c1de01"
      }
    },
    "owner": "reidbissell23s-team",
    "updates": {
      "url": "https://u.expo.dev/7ca94b1b-5354-470a-9275-e6ab67c1de01"
    }
  }
}
